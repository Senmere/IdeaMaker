<Window x:Class="IdeaMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IdeaMaker" Height="650" Width="750"
        Background="#1e1e2e">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#cdd6f4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#cdd6f4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8 4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="CaretBrush" Value="#cdd6f4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#1e1e2e"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
        </Style>
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#181825" BorderBrush="#313244" BorderThickness="0 0 0 1">
            <DockPanel Margin="16 10">
                <TextBlock Text="IdeaMaker" Foreground="#89b4fa" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0 0 28 0"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="TrashBtn" Click="TrashBtn_Click" Content="垃圾桶" Width="64" Height="30" Margin="0 0 6 0"/>
                    <Button x:Name="HistoryBtn" Click="HistoryBtn_Click" Content="历史" Width="52" Height="30" Margin="0 0 6 0"/>
                    <Button x:Name="SettingsBtn" Click="SettingsBtn_Click" Content="设置" Width="52" Height="30"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="积分" Foreground="#6c7086" FontSize="12" VerticalAlignment="Center" Margin="0 0 6 0"/>
                    <TextBlock x:Name="PointsText" Text="0" Foreground="#f9e2af" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0 0 20 0"/>
                    <TextBlock Text="完成" Foreground="#6c7086" FontSize="12" VerticalAlignment="Center" Margin="0 0 6 0"/>
                    <TextBlock x:Name="CompletedText" Text="0" Foreground="#a6e3a1" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28 24">
                <!-- 输入区 -->
                <TextBlock Text="输入主题" Foreground="#bac2de" FontSize="13" FontWeight="SemiBold" Margin="0 0 0 8"/>
                <TextBox x:Name="TopicBox" FontSize="13" Padding="12" Height="56"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0 0 0 16"/>

                <!-- 生成按钮 -->
                <Button x:Name="GenerateBtn" Click="GenerateBtn_Click"
                        Content="生成任务" Width="130" Height="34"
                        Background="#89b4fa" Foreground="#1e1e2e" FontWeight="SemiBold"
                        BorderThickness="0" HorizontalAlignment="Left" Margin="0 0 0 16"/>

                <!-- 生成中状态 -->
                <Border x:Name="GenStatusCard" Background="#313244" BorderBrush="#45475a" BorderThickness="1"
                        CornerRadius="6" Padding="16" Margin="0 0 0 16" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="GenStatus" Text="任务生成中..." Foreground="#a6e3a1" FontSize="12" Margin="0 0 10 0"/>
                        <TextBlock x:Name="GenText" Foreground="#cdd6f4" FontSize="13" LineHeight="22" TextWrapping="Wrap" Margin="0 12 0 0"/>
                    </StackPanel>
                </Border>

                <!-- 任务卡片 -->
                <Border x:Name="TaskCard" Background="#313244" BorderBrush="#45475a" BorderThickness="1"
                        CornerRadius="6" Padding="16" Margin="0 0 0 16" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel Margin="0 0 0 10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="难度" Foreground="#6c7086" FontSize="12" Margin="0 0 8 0"/>
                                <StackPanel x:Name="DifficultyStars" Orientation="Horizontal"/>
                                <TextBlock x:Name="DifficultyText" Text="3 / 5" Foreground="#f9e2af" FontSize="12" FontWeight="Bold" Margin="8 0 0 0"/>
                            </StackPanel>
                            <TextBlock x:Name="TopicLabel" DockPanel.Dock="Right" Foreground="#89b4fa" FontSize="12" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <TextBlock x:Name="TaskDesc" Foreground="#cdd6f4" FontSize="13" LineHeight="22" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 操作按钮 -->
                <StackPanel x:Name="ActionPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0 0 0 16">
                    <Button x:Name="CompleteBtn" Click="CompleteBtn_Click"
                            Content="完成" Width="90" Height="32" Background="#a6e3a1" Foreground="#1e1e2e" FontWeight="SemiBold" BorderThickness="0" Margin="0 0 10 0"/>
                    <Button x:Name="FailBtn" Click="FailBtn_Click"
                            Content="未完成" Width="90" Height="32" Background="#f38ba8" Foreground="#1e1e2e" FontWeight="SemiBold" BorderThickness="0" Margin="0 0 10 0"/>
                    <Button x:Name="RefreshBtn" Click="RefreshBtn_Click"
                            Content="换一个" Width="90" Height="32"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
